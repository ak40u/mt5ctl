#!/usr/bin/env bash
# systemctl stand-in for the test suite. Unit state lives in $FAKE_SYSTEMD:
#   <unit>.state     active | inactive | deactivating ...
#   <unit>.on-stop   executable run when the unit stops (terminal saving charts)
#   <unit>.on-start  executable run when the unit starts (terminal writing its journal)
#   <unit>.fail-<action>         makes that action fail without doing it
#   <unit>.fail-after-<action>   does the action, then reports failure (a dropped link)
#   <unit>.result    the Result systemd reports for the last stop (default success)
#   <unit>.killed    the terminal does not close itself: no exit line on stop
#   <unit>.env       the unit's Environment (show -p Environment)
#   journal_dir      where the terminal's journal lives (for the exit line)
#   calls            one line per state-changing call
set -u
D="${FAKE_SYSTEMD:?}"
[ "${1:-}" = "--user" ] && shift
cmd="${1:-}"; shift || true
state() { cat "$D/$1.state" 2>/dev/null || echo inactive; }
case "$cmd" in
  is-active)
    st=$(state "$1"); echo "$st"; [ "$st" = active ] ;;
  start|stop|restart)
    u="$1"; echo "$cmd $u" >> "$D/calls"
    [ -f "$D/$u.fail-$cmd" ] && { echo "fake: $cmd failed" >&2; exit 1; }
    if [ "$cmd" != start ]; then
      [ -x "$D/$u.on-stop" ] && "$D/$u.on-stop"
      # A terminal that closes itself writes its exit line to the journal.
      if [ -f "$D/journal_dir" ] && [ ! -f "$D/$u.killed" ]; then
        jd=$(cat "$D/journal_dir"); mkdir -p "$jd"
        printf 'GH\t0\t12:09:22.327\tTerminal\texit with code 0\r\n' \
          | iconv -f UTF-8 -t UTF-16LE >> "$jd/20261115.log"
      fi
      [ -f "$D/$u.stuck" ] && { echo deactivating > "$D/$u.state"; exit 0; }
      echo inactive > "$D/$u.state"
    fi
    if [ "$cmd" != stop ]; then
      echo active > "$D/$u.state"
      [ -x "$D/$u.on-start" ] && "$D/$u.on-start"
    fi
    [ -f "$D/$u.fail-after-$cmd" ] && { echo "fake: connection lost" >&2; exit 255; }
    exit 0 ;;
  cat)
    [ -f "$D/$1.missing" ] && { echo "No files found for $1." >&2; exit 1; }
    echo "[Unit]" ;;
  show)
    prop="$2"; u="$4"
    case "$prop" in
      User) cat "$D/$u.user" 2>/dev/null || true ;;
      ActiveEnterTimestampMonotonic) echo 0 ;;
      Result) cat "$D/$u.result" 2>/dev/null || echo success ;;
      Environment) cat "$D/$u.env" 2>/dev/null || true ;;
      *) echo "" ;;
    esac ;;
  *) echo "fake systemctl: unsupported command $cmd" >&2; exit 2 ;;
esac
