#!/usr/bin/env bash
# ImageMagick `import` stand-in: `import -window root png:-` writes a small PNG
# to stdout and records the display it was asked for; with
# $FAKE_SYSTEMD/import-fail present it fails the way import does without X.
set -u
echo "import DISPLAY=${DISPLAY:-} XAUTHORITY=${XAUTHORITY:-}" >> "$FAKE_SYSTEMD/calls"
if [ -e "$FAKE_SYSTEMD/import-fail" ]; then
  echo "import: unable to open X server \`${DISPLAY:-}'." >&2; exit 1
fi
printf '\211PNG\r\n\032\nfake image'
